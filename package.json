{
  "name": "next-dev-inspector",
  "version": "0.4.1",
  "description": "Dev-only floating inspector for Next.js + React 18/19: click any DOM element to open its source file in your editor (click-to-component), view live props and store state, reverse-lookup i18n keys, flash component re-renders, and copy element context for AI assistants.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infinitietechnologies/dev-inspector.git"
  },
  "homepage": "https://github.com/Infinitietechnologies/dev-inspector#readme",
  "bugs": {
    "url": "https://github.com/Infinitietechnologies/dev-inspector/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "import": "./dist/hook.js",
      "require": "./dist/hook.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "nextjs",
    "next",
    "react",
    "devtools",
    "inspector",
    "dev-inspector",
    "component-inspector",
    "click-to-component",
    "open-in-editor",
    "source-map",
    "debug",
    "debugging",
    "turbopack",
    "app-router",
    "react-devtools",
    "re-render",
    "i18n",
    "dx"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
